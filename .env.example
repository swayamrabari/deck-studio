# ── Database (Supabase Postgres) ────────────────────────────────────────
# Use the "Transaction pooler" connection string from Supabase:
# Project Settings → Database → Connection string → Transaction pooler
# (port 6543). Works for both local dev and Vercel. SSL is enforced and
# added automatically if the URL doesn't carry sslmode.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# ── Auth ────────────────────────────────────────────────────────────────
# Optional: re-open account registration. Unset = closed (single-user mode,
# login only). Set to 1 or true to allow signups.
# ALLOW_SIGNUPS=1
